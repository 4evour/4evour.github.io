---
import { Icon } from "astro-icon/components";
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const visibleHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
---

{
  visibleHeadings.length > 0 && (
    <aside class="toc" aria-label="文章目录">
      <div class="toc-heading">
        <span>本页目录</span>
        <small>{visibleHeadings.length} 节</small>
      </div>
      <button
        class="toc-toggle"
        type="button"
        data-toc-toggle
        aria-expanded="false"
        aria-controls="toc-nav"
      >
        <span class="toc-toggle-copy">
          <strong>目录 · {visibleHeadings.length} 节</strong>
          <small data-toc-current>{visibleHeadings[0]?.text}</small>
        </span>
        <Icon name="lucide:chevron-down" aria-hidden="true" />
      </button>
      <nav class="toc-nav" id="toc-nav">
        <ol>
          {visibleHeadings.map((heading) => (
            <li class={`toc-depth-${heading.depth}`}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    </aside>
  )
}

<script is:inline data-astro-rerun>
  (() => {
    const toc = document.querySelector(".toc");
    if (!toc || toc.dataset.tocReady === "true") return;
    toc.dataset.tocReady = "true";

    requestAnimationFrame(() => {
      // Mobile toggle
      const toggle = toc.querySelector("[data-toc-toggle]");
      if (toggle) {
        toggle.addEventListener("click", () => {
          const isOpen = toc.classList.toggle("is-open");
          toggle.setAttribute("aria-expanded", String(isOpen));
        });
      }

      // Scroll-spy
      const tocLinks = toc.querySelectorAll(".toc-nav a");
      if (!tocLinks.length) return;

      const controller = new AbortController();
      let activeLink = null;
      let frame = 0;
      const currentLabel = toc.querySelector("[data-toc-current]");
      const articleBody = document.querySelector(".article-body");
      const trackedHeadings = [];

      const setActive = (link) => {
        if (activeLink) activeLink.classList.remove("is-active");
        if (link) link.classList.add("is-active");
        activeLink = link;
        if (currentLabel && link) currentLabel.textContent = link.textContent?.trim() ?? "";
      };

      tocLinks.forEach((link) => {
        const hash = link.getAttribute("href");
        if (!hash) return;
        const heading = document.getElementById(hash.slice(1));
        if (heading) trackedHeadings.push({ heading, link });
        link.addEventListener("click", () => {
          toc.classList.remove("is-open");
          toggle?.setAttribute("aria-expanded", "false");
        }, { signal: controller.signal });
      });

      const updateReadingState = () => {
        frame = 0;
        const marker = window.innerHeight * 0.24;
        let current = trackedHeadings[0];
        for (const candidate of trackedHeadings) {
          if (candidate.heading.getBoundingClientRect().top <= marker) current = candidate;
          else break;
        }
        if (current) setActive(current.link);

        if (articleBody) {
          const rect = articleBody.getBoundingClientRect();
          const scrollable = Math.max(1, rect.height - window.innerHeight * 0.55);
          const progress = Math.min(1, Math.max(0, (marker - rect.top) / scrollable));
          toc.style.setProperty("--toc-progress", `${progress * 100}%`);
        }
      };

      const scheduleUpdate = () => {
        if (!frame) frame = requestAnimationFrame(updateReadingState);
      };

      window.addEventListener("scroll", scheduleUpdate, { passive: true, signal: controller.signal });
      window.addEventListener("resize", scheduleUpdate, { passive: true, signal: controller.signal });
      updateReadingState();

      document.addEventListener(
        "astro:before-swap",
        () => {
          if (frame) cancelAnimationFrame(frame);
          controller.abort();
          delete toc.dataset.tocReady;
        },
        { once: true },
      );
    });
  })();
</script>
