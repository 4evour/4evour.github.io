---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostList from "../components/PostList.astro";
import DailyPoem from "../components/DailyPoem.astro";
import { getPublishedPosts } from "../utils/posts";

const posts = await getPublishedPosts();
const latestPosts = posts.slice(0, 3);
---

<BaseLayout>
  <section class="hero hero-redesign">
    <div class="container hero-inner">
      <div class="hero-copy-block">
        <h1>4evour</h1>
        <div class="hero-actions">
          <a class="button primary" href="/blog/">阅读文章</a>
          <a class="button" href="/about/">了解我</a>
        </div>
        <dl class="hero-stats" aria-label="站点概览">
          <div>
            <dt>{posts.length}</dt>
            <dd>篇文章</dd>
          </div>
        </dl>
      </div>

      <aside class="hero-visual" aria-label="个人内容视觉">
        <DailyPoem />
      </aside>
    </div>
  </section>

  <section class="container section">
    <div class="section-head">
      <div>
        <p class="eyebrow">最近记录</p>
        <h2>最近文章</h2>
        <p>从最近写下的内容开始认识我。</p>
      </div>
      <a class="button" href="/blog/">全部文章</a>
    </div>
    <PostList posts={latestPosts} />
  </section>
</BaseLayout>
