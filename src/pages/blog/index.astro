---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";
import { getAllTags, getPublishedPosts } from "../../utils/posts";

const posts = await getPublishedPosts();
const tags = getAllTags(posts);
---

<BaseLayout title="文章" description="4evour 的博客文章列表。" pageClass="reading-page blog-page">
  <section class="container page-title">
    <p class="eyebrow">Writing archive</p>
    <h1>文章</h1>
    <p>技术、学习、项目复盘、生活与思考，都会在这里慢慢长出来。</p>
    <nav class="blog-topic-nav" aria-label="文章分类">
      <span>浏览分类</span>
      {tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>)}
    </nav>
  </section>
  <section class="container section blog-list-section">
    <PostList posts={posts} variant="list" />
  </section>
</BaseLayout>
