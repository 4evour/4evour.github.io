---
import { Icon } from "astro-icon/components";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { categoryDefinitions, getPublishedPosts } from "../../utils/posts";

const posts = await getPublishedPosts();

const getTopic = (post: (typeof posts)[number]) => {
  return categoryDefinitions.find((topic) => topic.id === post.data.category) ?? categoryDefinitions[3];
};

const indexedPosts = posts.map((post) => {
  const topic = getTopic(post);
  const searchText = [
    post.data.title,
    post.data.description,
    post.data.project,
    topic.label,
    ...post.data.tags,
  ]
    .filter(Boolean)
    .join(" ")
    .toLocaleLowerCase();

  return { post, topic, searchText };
});

const topics = categoryDefinitions.map(({ id, label }) => ({
  id,
  label,
  count: indexedPosts.filter((item) => item.topic.id === id).length,
}));

const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const tags = Array.from(tagCounts, ([label, count]) => ({ label, count })).sort(
  (a, b) => b.count - a.count || a.label.localeCompare(b.label, "zh-CN"),
);

const postsByYear = new Map<number, typeof indexedPosts>();
for (const item of indexedPosts) {
  const year = item.post.data.pubDate.getFullYear();
  const group = postsByYear.get(year) ?? [];
  group.push(item);
  postsByYear.set(year, group);
}

const formatArchiveDate = (date: Date) =>
  new Intl.DateTimeFormat("zh-CN", { month: "long", day: "numeric" }).format(date);
---

<BaseLayout title="文章" description="按主题浏览和搜索 4evour 的项目、技术、算法与杂谈。" pageClass="reading-page blog-page">
  <section class="container page-title blog-index-hero">
    <div class="blog-index-title-row">
      <div>
        <p class="eyebrow">Writing archive</p>
        <h1>文章</h1>
        <p>把项目、技术与学习过程整理成可以检索、可以继续阅读的记录。</p>
      </div>
      <p class="blog-archive-total"><strong>{posts.length}</strong><span>篇记录</span></p>
    </div>

    <div class="blog-search" role="search">
      <Icon name="lucide:search" aria-hidden="true" />
      <input
        type="search"
        placeholder="搜索标题、摘要、技术或项目"
        autocomplete="off"
        aria-label="搜索文章"
        data-blog-search
      />
      <button type="button" aria-label="清除搜索" data-blog-search-clear hidden>
        <Icon name="lucide:x" aria-hidden="true" />
      </button>
    </div>
  </section>

  <section class="container section blog-archive-section" data-blog-archive>
    <header class="blog-archive-toolbar">
      <div>
        <p class="eyebrow">Browse the archive</p>
        <h2>按栏目浏览</h2>
      </div>
      <p class="blog-filter-status" aria-live="polite" data-blog-filter-status>显示全部 {posts.length} 篇文章</p>
    </header>

    <div class="blog-topic-filters" role="group" aria-label="文章栏目">
      <button class="is-active" type="button" data-blog-topic="all" aria-pressed="true">
        <span>全部</span><small>{posts.length}</small>
      </button>
      {
        topics.map((topic) => (
          <button type="button" data-blog-topic={topic.id} aria-pressed="false">
            <span>{topic.label}</span><small>{topic.count}</small>
          </button>
        ))
      }
    </div>

    <details class="blog-tag-filter" data-blog-tags-details>
      <summary>
        <Icon name="lucide:tags" aria-hidden="true" />
        <span>按标签筛选</span>
        <strong data-blog-active-tag>全部标签</strong>
        <small>{tags.length} 个</small>
        <Icon class="blog-tag-chevron" name="lucide:chevron-down" aria-hidden="true" />
      </summary>
      <div class="blog-tag-options" role="group" aria-label="文章标签">
        <button class="is-active" type="button" data-blog-tag="all" aria-pressed="true">
          <span>全部标签</span><small>{posts.length}</small>
        </button>
        {
          tags.map((tag) => (
            <button type="button" data-blog-tag={tag.label.toLocaleLowerCase()} aria-pressed="false">
              <span>{tag.label}</span><small>{tag.count}</small>
            </button>
          ))
        }
      </div>
    </details>

    <div class="blog-year-groups">
      {
        Array.from(postsByYear.entries()).map(([year, yearPosts]) => (
          <section class="blog-year-group" data-blog-year-group>
            <header class="blog-year-heading">
              <h2>{year}</h2>
              <span data-blog-year-count>{yearPosts.length} 篇</span>
            </header>
            <ol class="blog-archive-list">
              {yearPosts.map(({ post, topic, searchText }) => (
                <li
                  data-blog-entry
                  data-topic={topic.id}
                  data-tags={JSON.stringify(post.data.tags.map((tag) => tag.toLocaleLowerCase()))}
                  data-search={searchText}
                >
                  <a class="blog-archive-link" href={`/blog/${post.id}/`}>
                    <span class="blog-archive-topic">{topic.label}</span>
                    <span class="blog-archive-copy">
                      <strong>{post.data.title}</strong>
                      <span>{post.data.description}</span>
                      {post.data.project && <small>{post.data.project}</small>}
                    </span>
                    <time datetime={post.data.pubDate.toISOString()}>{formatArchiveDate(post.data.pubDate)}</time>
                    <Icon class="blog-archive-arrow" name="lucide:arrow-up-right" aria-hidden="true" />
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>

    <div class="blog-empty-state" data-blog-empty hidden>
      <Icon name="lucide:search-x" aria-hidden="true" />
      <strong>没有找到匹配文章</strong>
      <p>试试更短的关键词，或切换到其他栏目。</p>
    </div>
  </section>
</BaseLayout>

<script>
  const setupBlogArchive = () => {
    const root = document.querySelector<HTMLElement>("[data-blog-archive]");
    const input = document.querySelector<HTMLInputElement>("[data-blog-search]");
    const clearButton = document.querySelector<HTMLButtonElement>("[data-blog-search-clear]");
    if (!root || !input || !clearButton || root.dataset.ready === "true") return;

    const entries = Array.from(root.querySelectorAll<HTMLElement>("[data-blog-entry]"));
    const topicButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-blog-topic]"));
    const tagButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-blog-tag]"));
    const yearGroups = Array.from(root.querySelectorAll<HTMLElement>("[data-blog-year-group]"));
    const status = root.querySelector<HTMLElement>("[data-blog-filter-status]");
    const emptyState = root.querySelector<HTMLElement>("[data-blog-empty]");
    const tagDetails = root.querySelector<HTMLDetailsElement>("[data-blog-tags-details]");
    const activeTagLabel = root.querySelector<HTMLElement>("[data-blog-active-tag]");
    const entryTags = new Map(
      entries.map((entry) => [entry, JSON.parse(entry.dataset.tags ?? "[]") as string[]]),
    );
    let activeTopic = "all";
    let activeTag = "all";
    let activeTagText = "全部标签";

    const normalize = (value: string) => value.trim().toLocaleLowerCase();

    const applyFilters = () => {
      const query = normalize(input.value);
      let visibleTotal = 0;

      for (const entry of entries) {
        const matchesTopic = activeTopic === "all" || entry.dataset.topic === activeTopic;
        const matchesTag = activeTag === "all" || entryTags.get(entry)?.includes(activeTag);
        const matchesSearch = !query || (entry.dataset.search ?? "").includes(query);
        entry.hidden = !(matchesTopic && matchesTag && matchesSearch);
        if (!entry.hidden) visibleTotal += 1;
      }

      for (const group of yearGroups) {
        const visibleInYear = group.querySelectorAll<HTMLElement>("[data-blog-entry]:not([hidden])").length;
        group.hidden = visibleInYear === 0;
        const count = group.querySelector<HTMLElement>("[data-blog-year-count]");
        if (count) count.textContent = `${visibleInYear} 篇`;
      }

      clearButton.hidden = !query;
      const filterLabels = [];
      if (activeTopic !== "all") {
        const topicLabel = topicButtons.find((button) => button.dataset.blogTopic === activeTopic)
          ?.querySelector("span")?.textContent;
        if (topicLabel) filterLabels.push(topicLabel);
      }
      if (activeTag !== "all") filterLabels.push(`标签「${activeTagText}」`);
      if (query) filterLabels.push(`搜索「${input.value.trim()}」`);
      if (status) {
        status.textContent = filterLabels.length
          ? `${filterLabels.join(" · ")}：${visibleTotal} 篇`
          : `当前显示 ${visibleTotal} 篇文章`;
      }
      if (emptyState) emptyState.hidden = visibleTotal !== 0;
    };

    for (const button of topicButtons) {
      button.addEventListener("click", () => {
        activeTopic = button.dataset.blogTopic ?? "all";
        for (const candidate of topicButtons) {
          const isActive = candidate === button;
          candidate.classList.toggle("is-active", isActive);
          candidate.setAttribute("aria-pressed", String(isActive));
        }
        applyFilters();
      });
    }

    for (const button of tagButtons) {
      button.addEventListener("click", () => {
        const selectedTag = button.dataset.blogTag ?? "all";
        const shouldClear = selectedTag !== "all" && selectedTag === activeTag;
        activeTag = shouldClear ? "all" : selectedTag;
        activeTagText = shouldClear
          ? "全部标签"
          : button.querySelector("span")?.textContent?.trim() ?? "全部标签";
        for (const candidate of tagButtons) {
          const isActive = candidate.dataset.blogTag === activeTag;
          candidate.classList.toggle("is-active", isActive);
          candidate.setAttribute("aria-pressed", String(isActive));
        }
        if (activeTagLabel) activeTagLabel.textContent = activeTagText;
        if (tagDetails) tagDetails.open = false;
        applyFilters();
      });
    }

    input.addEventListener("input", applyFilters);
    input.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && input.value) {
        input.value = "";
        applyFilters();
      }
    });
    clearButton.addEventListener("click", () => {
      input.value = "";
      input.focus();
      applyFilters();
    });

    root.dataset.ready = "true";
    applyFilters();
  };

  setupBlogArchive();
  document.addEventListener("astro:page-load", setupBlogArchive);
</script>
