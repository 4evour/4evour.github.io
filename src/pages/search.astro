---
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedPosts } from "../utils/posts";

const posts = await getPublishedPosts();
const fallbackSearchDocuments = posts.map((post) => ({
  title: post.data.title,
  description: post.data.description,
  tags: post.data.tags,
  project: post.data.project ?? "",
  url: `/blog/${post.id}/`,
}));
const fallbackSearchData = JSON.stringify(fallbackSearchDocuments).replace(/</g, "\\u003c");
---

<BaseLayout title="搜索" description="搜索 4evour blog 的文章、项目和标签。">
  <section class="container page-title search-title">
    <p class="eyebrow">Search</p>
    <h1>搜索</h1>
    <p>输入关键词，快速找到文章、项目和标签。</p>
  </section>

  <section class="container section search-section" aria-label="站内搜索">
    <div class="search-box">
      <Icon name="lucide:search" aria-hidden="true" />
      <input
        type="search"
        placeholder="搜索 RAG、Live2D、Go..."
        autocomplete="off"
        aria-label="搜索关键词"
        data-search-input
      />
    </div>
    <p class="search-status" data-search-status>输入关键词开始搜索。</p>
    <ol class="search-results" data-search-results></ol>
  </section>
</BaseLayout>

<script type="application/json" id="search-fallback-data" is:inline set:html={fallbackSearchData}></script>

<script>
  type SearchResult = {
    title: string;
    excerpt: string;
    url: string;
  };

  type PagefindSearchFragment = {
    excerpt?: string;
    meta?: {
      title?: string;
    };
    raw_url?: string;
    url?: string;
  };

  type PagefindResult = {
    data: () => Promise<PagefindSearchFragment>;
  };

  type PagefindSearchResponse = {
    results: PagefindResult[];
  };

  type PagefindModule = {
    search: (query: string) => Promise<PagefindSearchResponse>;
  };

  const pagefindPath = "/pagefind/pagefind.js";
  let pagefindReady: Promise<PagefindModule | null> | undefined;

  const setStatus = (status: HTMLElement | null, message: string) => {
    if (status) status.textContent = message;
  };

  const loadPagefind = async () => {
    if (!pagefindReady) {
      pagefindReady = import(/* @vite-ignore */ pagefindPath)
        .then((module) => (typeof module.search === "function" ? module : null))
        .catch(() => null);
    }

    return pagefindReady;
  };

  const clearResults = (results: HTMLOListElement | null) => {
    if (results) results.innerHTML = "";
  };

  const stripMarkup = (value: string) => {
    const documentFragment = new DOMParser().parseFromString(value, "text/html");
    return documentFragment.body.textContent ?? "";
  };

  const getFallbackDocuments = () => {
    const data = document.querySelector<HTMLScriptElement>("#search-fallback-data");

    if (!data?.textContent) return [];

    try {
      return JSON.parse(data.textContent) as Array<{
        title: string;
        description: string;
        tags: string[];
        project: string;
        url: string;
      }>;
    } catch {
      return [];
    }
  };

  const searchFallback = (query: string): SearchResult[] => {
    const normalizedQuery = query.toLocaleLowerCase();

    return getFallbackDocuments()
      .filter((post) =>
        [post.title, post.description, ...post.tags, post.project]
          .join(" ")
          .toLocaleLowerCase()
          .includes(normalizedQuery),
      )
      .slice(0, 12)
      .map((post) => ({
        title: post.title,
        excerpt: post.description,
        url: post.url,
      }));
  };

  const renderResultList = (
    query: string,
    searchResults: SearchResult[],
    total: number,
    status: HTMLElement | null,
    results: HTMLOListElement | null,
  ) => {
    clearResults(results);

    if (searchResults.length === 0) {
      setStatus(status, `没有找到“${query}”。`);
      return;
    }

    setStatus(status, `找到 ${total} 条结果。`);

    for (const result of searchResults) {
      const item = document.createElement("li");
      const link = document.createElement("a");
      const title = document.createElement("strong");
      const excerpt = document.createElement("p");

      link.href = result.url;
      title.textContent = result.title;
      excerpt.textContent = result.excerpt;

      link.append(title, excerpt);
      item.append(link);
      results?.append(item);
    }
  };

  const renderResults = async (
    query: string,
    status: HTMLElement | null,
    results: HTMLOListElement | null,
  ) => {
    const trimmedQuery = query.trim();
    if (!trimmedQuery) {
      setStatus(status, "输入关键词开始搜索。");
      clearResults(results);
      return;
    }

    const pagefind = await loadPagefind();

    if (pagefind) {
      try {
        const search = await pagefind.search(trimmedQuery);
        const pagefindResults = await Promise.all(search.results.slice(0, 12).map((result) => result.data()));
        const searchResults = pagefindResults.map((result) => ({
          title: result.meta?.title ?? "未命名页面",
          excerpt: stripMarkup(result.excerpt ?? ""),
          url: result.url ?? result.raw_url ?? "/",
        }));

        renderResultList(trimmedQuery, searchResults, search.results.length, status, results);
        return;
      } catch {
        // Fall back to the metadata search while the generated index is unavailable.
      }
    }

    const fallbackResults = searchFallback(trimmedQuery);
    renderResultList(trimmedQuery, fallbackResults, fallbackResults.length, status, results);
  };

  const setupSearch = () => {
    const input = document.querySelector<HTMLInputElement>("[data-search-input]");
    if (!input || input.dataset.searchReady === "true") return;

    const status = document.querySelector<HTMLElement>("[data-search-status]");
    const results = document.querySelector<HTMLOListElement>("[data-search-results]");

    input.dataset.searchReady = "true";
    input.addEventListener("input", () => {
      void renderResults(input.value, status, results);
    });

    setStatus(status, "输入关键词开始搜索。");
  };

  setupSearch();
  document.addEventListener("astro:page-load", setupSearch);
</script>
