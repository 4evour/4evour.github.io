---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPostsByProject, getPublishedPosts } from "../utils/posts";

const posts = await getPublishedPosts();
const scenicGuideName = "灵山胜境智能导览系统";
const scenicGuidePosts = getPostsByProject(posts, scenicGuideName);
const tourPassName = "Tour Pass";
const tourPassPosts = getPostsByProject(posts, tourPassName);
---

<BaseLayout title="项目" description="4evour 的项目与作品。" pageClass="projects-page">
  <section class="container page-title project-index-title">
    <div>
      <p class="eyebrow">Projects</p>
      <h1>项目</h1>
      <p>把做过的项目整理成可以继续阅读的入口，而不只是放几个仓库链接。</p>
    </div>
  </section>
  <section class="container section project-index-list">
    <a class="project-card" href="/projects/scenic-guide/">
      <div class="project-card-media">
        <img
          src="/images/blog/scenic-guide/home.png"
          alt="灵山胜境智能导览系统游客端首页"
          width="1440"
          height="1000"
        />
        <span aria-hidden="true">01 / AI 导览</span>
      </div>
      <div class="project-card-copy">
        <div>
          <div class="project-card-topline">
            <p class="eyebrow">Case study / 01</p>
            <span>{scenicGuidePosts.length} 篇文章</span>
          </div>
          <h2>{scenicGuideName}</h2>
          <p>
            一个 Go + Vue + RAG + Live2D 的景区智能导览系统，包含官方资料知识库、
            管理后台、数据看板、电子围栏、二维码和游客反馈闭环。
          </p>
        </div>
        <div class="tag-list">
          <span class="tag">Go</span>
          <span class="tag">Vue</span>
          <span class="tag">RAG</span>
          <span class="tag">反馈闭环</span>
        </div>
        <span class="project-card-cta">查看项目档案 <b aria-hidden="true">↗</b></span>
      </div>
    </a>

    <a class="project-card project-card-tour" href="/projects/tour-pass/">
      <div class="project-card-media">
        <img
          src="/videos/tour-pass/tour-pass-web-demo-poster.jpg"
          alt="Tour Pass 多候选城市行程规划界面"
          width="1280"
          height="720"
        />
        <span aria-hidden="true">02 / 行程规划</span>
      </div>
      <div class="project-card-copy">
        <div>
          <div class="project-card-topline">
            <p class="eyebrow">Case study / 02</p>
            <span>{tourPassPosts.length} 篇文章</span>
          </div>
          <h2>{tourPassName}</h2>
          <p>
            一个 C++17 + Python Agent 城市自由行规划项目，覆盖 POI 图、Beam Search、
            LangGraph 多 Agent、21 城市数据、React 行程编辑器和线上演示。
          </p>
        </div>
        <div class="tag-list">
          <span class="tag">C++</span>
          <span class="tag">Python</span>
          <span class="tag">LangGraph</span>
          <span class="tag">React</span>
        </div>
        <span class="project-card-cta">查看项目档案 <b aria-hidden="true">↗</b></span>
      </div>
    </a>
  </section>
</BaseLayout>
